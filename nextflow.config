// Nextflow configuration file

// Default parameters
params {
    input = "data/raw_data.csv"
    outdir = "results"
    seed = 42
}

// Process-specific configurations
process {
    // Default container settings
    containerOptions = '--rm'
    
    withName: 'preprocess' {
        container = 'preprocess:latest'
        publishDir = [
            path: "${params.outdir}/processed", 
            mode: 'copy'
        ]
        // Use single quotes to properly handle paths with spaces
        containerOptions = { "--rm -v '$PWD/scripts:/app/scripts:ro'" }
    }
    
    withName: 'train_model' {
        container = 'model:latest'
        publishDir = [
            path: "${params.outdir}", 
            mode: 'copy'
        ]
        // Use single quotes to properly handle paths with spaces
        containerOptions = { "--rm -v '$PWD/scripts:/app/scripts:ro'" }
    }
}

// Docker settings
docker {
    enabled = true
}

// Execution settings
executor {
    name = 'local'
    cpus = 4
    memory = '8 GB'
}

// Timeline reporting
timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
}

// Execution report
report {
    enabled = true
    file = "${params.outdir}/report.html"
}